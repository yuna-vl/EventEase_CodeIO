# Port for the Node.js Express server
PORT=5000

# Client origin for CORS handling
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (placeholder - replace with your actual cluster details)
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_address>/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@eventeasecluster.mongodb.net/eventease_db?retryWrites=true&w=majority

# JSON Web Token Secret (use a strong random secret key)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Initial Organizer Seed Credentials (used by seed script to create initial admin)
INITIAL_ORGANIZER_NAME=EventEase Admin
INITIAL_ORGANIZER_EMAIL=admin@eventease.live
INITIAL_ORGANIZER_PASSWORD=your_secure_organizer_password_here
